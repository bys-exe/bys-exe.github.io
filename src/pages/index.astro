---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import LastFM from "../components/LastFM.astro";
import BadgeMarquee from "../components/BadgeMarquee.astro";

const latestPosts = (await getCollection("blog"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);

const latestProjects = (await getCollection("projects"))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<BaseLayout title="Home - Yuga Sai" showFooterRedirect={false}>
    <div class="max-w-2xl mx-auto px-4">
        <Header />
        <main class="py-8">
            <div
                class="flex flex-col sm:flex-row items-center gap-4 mb-8 text-center sm:text-left"
            >
                <img
                    src="/images/pfp.jpg"
                    alt="Yuga Sai"
                    class="w-24 h-24 rounded-full border-2 border-gray-300 dark:border-gray-600 shrink-0"
                />
                <h1 class="text-2xl sm:text-3xl font-bold">
                    Hello, I'm yuga :>
                </h1>
            </div>

            <p class="mb-4">
                Welcome to my little corner of the internet! This site is still
                a work in progress but you can find <a
                    href="/about"
                    class="text-[var(--accent)] hover:underline">about</a
                > me, my <a
                    href="/projects"
                    class="text-[var(--accent)] hover:underline">projects</a
                > and my <a href="/blog" class="text-[var(--accent)] hover:underline"
                    >blogs</a
                > in the site.
            </p>

            <section
                class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-8 items-start"
            >
                <div class="min-w-0">
                    <LastFM />
                </div>
                <div class="min-w-0">
                    <BadgeMarquee />
                </div>
            </section>

            <section
                class="mt-16 pt-16 border-t border-gray-300 dark:border-gray-800"
            >
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-2xl font-bold underline underline-offset-8">Blogs</h2>
                    <a
                        href="/blog"
                        class="text-sm text-[var(--accent)] hover:underline"
                        >see all&rarr;</a
                    >
                </div>
                <ul class="space-y-6">
                    {
                        latestPosts.map((post) => (
                            <li>
                                <div class="flex items-baseline justify-between gap-4">
                                    <h3 class="text-lg sm:text-xl font-semibold">
                                        <a
                                            href={`/blog/${post.id}`}
                                            class="hover:text-[var(--accent)] transition-colors"
                                        >
                                            {post.data.title}
                                        </a>
                                    </h3>
                                    <time
                                        datetime={post.data.pubDate.toISOString()}
                                        class="text-sm text-gray-500 shrink-0"
                                    >
                                        {post.data.pubDate.toLocaleDateString(
                                            "en-us",
                                            {
                                                year: "numeric",
                                                month: "short",
                                                day: "numeric",
                                            },
                                        )}
                                    </time>
                                </div>
                                <p class="text-sm text-gray-600 dark:text-gray-400">
                                    {post.data.description}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section
                class="mt-16 pt-16 border-t border-gray-300 dark:border-gray-800"
            >
                <div class="flex items-center justify-between mb-4">
                    <h2 class="text-2xl font-bold underline underline-offset-8">Projects</h2>
                    <a
                        href="/projects"
                        class="text-sm text-[var(--accent)] hover:underline"
                        >see all&rarr;</a
                    >
                </div>
                <ul class="space-y-6">
                    {
                        latestProjects.map((project) => (
                            <li>
                                <div class="flex items-baseline justify-between gap-4">
                                    <h3 class="text-lg sm:text-xl font-semibold">
                                        <a
                                            href={`/projects/${project.id}`}
                                            class="hover:text-[var(--accent)] transition-colors"
                                        >
                                            {project.data.title}
                                        </a>
                                    </h3>
                                </div>
                                <p class="text-sm text-gray-600 dark:text-gray-400">
                                    {project.data.description}
                                </p>
                            </li>
                        ))
                    }
                </ul>
            </section>

            <section
                class="mt-16 pt-16 border-t border-gray-300 dark:border-gray-800"
            >
                <h2 class="text-2xl font-bold mb-4 underline underline-offset-8">
                    Experiences
                </h2>
                <p class="mb-4">
                    I currently have no experiences but i'm open to work! here's
                    my <a
                        href="/resume.pdf"
                        class="text-[var(--accent)] hover:underline">resume</a
                    >.
                </p>
            </section>
        </main>
    </div>
</BaseLayout>
