---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="Home - Yuga Sai" showFooterRedirect={false}>
    <div class="max-w-2xl mx-auto px-4">
        <Header />
        <main class="py-8">
            <div
                class="flex flex-col sm:flex-row items-center gap-4 mb-8 text-center sm:text-left"
            >
                <img
                    src="/images/pfp.jpg"
                    alt="Yuga Sai"
                    class="w-32 h-32 rounded-full border-2 border-gray-300 dark:border-gray-600 shrink-0"
                />
                <h1 class="text-2xl sm:text-3xl font-bold">
                    Hallo, I'm yuga :>
                </h1>
            </div>

            <!-- write your homepage content here -->
            <p class="mb-4">
                Welcome to my little corner of the internet. This page is still
                a work in progress, but you can find my <a
                    href="/about"
                    class="text-[var(--accent)] hover:underline">about</a
                >, <a
                    href="/projects"
                    class="text-[var(--accent)] hover:underline">projects</a
                >, <a
                    href="/blog"
                    class="text-[var(--accent)] hover:underline">blog</a
                >, and more around the site.
            </p>
        </main>
    </div>
</BaseLayout>
