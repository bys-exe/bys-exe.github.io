---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="Contact - Yuga Sai" showFooterRedirect={true}>
    <div class="max-w-2xl mx-auto px-4">
        <Header />
        <main class="py-8">
            <h1 class="text-2xl sm:text-3xl font-bold mb-8">Contact Me</h1>
            <p class="text-gray-600 dark:text-gray-400 mb-8">
                Feel free to reach out to me through any of the following
                channels:
            </p>

            <ul class="space-y-6">
                <li class="flex items-start gap-4">
                    <svg
                        class="w-6 h-6 text-gray-500 shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                    </svg>
                    <div class="min-w-0">
                        <span class="block text-sm font-semibold text-gray-400"
                            >Email</span
                        >
                        <a
                            href="mailto:batchuyugasai@gmail.com"
                            class="text-[var(--accent)] hover:underline break-all"
                            >batchuyugasai@gmail.com</a
                        >
                    </div>
                </li>

                <li class="flex items-start gap-4">
                    <svg
                        class="w-6 h-6 text-gray-500 shrink-0 mt-0.5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
                        ></path>
                    </svg>
                    <div>
                        <span class="block text-sm font-semibold text-gray-400"
                            >LinkedIn</span
                        >
                        <a
                            href="https://www.linkedin.com/in/batchu-yuga-sai-68418136b/"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[var(--accent)] hover:underline break-all"
                            >Batchu yuga sai</a
                        >
                    </div>
                </li>

                <li class="flex items-start gap-4">
                    <svg
                        class="w-6 h-6 text-gray-500 shrink-0 mt-0.5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            fill-rule="evenodd"
                            clip-rule="evenodd"
                            d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.603-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.462-1.11-1.462-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.577.688.479C19.138 20.164 22 16.418 22 12c0-5.523-4.477-10-10-10z"
                        ></path>
                    </svg>
                    <div>
                        <span class="block text-sm font-semibold text-gray-400"
                            >GitHub</span
                        >
                        <a
                            href="https://github.com/bys-exe"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[var(--accent)] hover:underline">bys-exe</a
                        >
                    </div>
                </li>

                <li class="flex items-start gap-4">
                    <svg
                        class="w-6 h-6 text-gray-500 shrink-0 mt-0.5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                        ></path>
                    </svg>
                    <div>
                        <span class="block text-sm font-semibold text-gray-400"
                            >X (formerly Twitter)</span
                        >
                        <a
                            href="https://x.com/bys_exe"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-[var(--accent)] hover:underline">@bys_exe</a
                        >
                    </div>
                </li>
            </ul>
        </main>
    </div>
</BaseLayout>
