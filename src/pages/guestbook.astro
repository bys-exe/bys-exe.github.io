---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Comments from "../components/Comments.astro";
---

<BaseLayout title="Guestbook - Yuga Sai" showFooterRedirect={true}>
    <div class="max-w-2xl mx-auto px-4">
        <Header />
        <main class="py-8">
            <h1 class="text-2xl sm:text-3xl font-bold mb-4">Guestbook</h1>
            <p class="mb-4 text-gray-600 dark:text-gray-400">
                WAIT- Before you go, leave a message in the guestbook!
            </p>

            <Comments
                reactionsEnabled={false}
                category="Comments"
                categoryId="DIC_kwDOTJwhRc4DGS5M"
            />
        </main>
    </div>
</BaseLayout>
