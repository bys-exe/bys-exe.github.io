---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import LastFM from "../components/LastFM.astro";
---

<BaseLayout title="About Me - Yuga Sai" showFooterRedirect={true}>
    <div class="max-w-2xl mx-auto px-4">
        <LastFM />
        <Header />
        <div class="fixed bottom-4 left-4 z-50 flex flex-col items-start">
            <p
                class="text-[10px] uppercase tracking-widest text-[var(--text-muted)] mb-[5px]"
            >
                Visitor count
            </p>
            <img
                id="visitors-counter"
                src="https://count.getloli.com/@bys-site?name=bys-site&theme=original-new&padding=4&offset=0&align=top&scale=0.5&pixelated=1&darkmode=auto"
                alt="Visitors counter"
            />
        </div>
        <main class="py-8">
            <h1 class="text-2xl sm:text-3xl font-bold mb-8">About</h1>
            <p class="mb-4">
                I am an 18-year-old developer currently studying CS at <a
                    href="https://en.wikipedia.org/wiki/Jain_University"
                    class="text-[var(--accent)] hover:underline"
                    >Jain University</a
                >. I'm currently still figuring out what excites me :P
            </p>
            <p class="mb-4">
                I enjoy consuming all forms of art/ media and my entire
                personality surrounds around it.
            </p>
            <p class="mb-4">
                When i was a kid i was always fascinated by computers and
                tinkered with them. I had a very old laptop with only 2gb ram
                (currently my home server lol) and i was always trying to get
                the most out of it and i even had a windows xp office computer
                with which i played around alot and they made me love computers.
            </p>
            <p class="mb-4">
                I'm new to making <a
                    href="/blog"
                    class="text-[var(--accent)] hover:underline">blogs</a
                > and i hope people enjoy it :D and check out my <a
                    href="/projects"
                    class="text-[var(--accent)] hover:underline">projects</a
                > if you are interested.
            </p>
        </main>
    </div>
</BaseLayout>

<script>
    const counter = document.getElementById(
        "visitors-counter",
    ) as HTMLImageElement | null;
    if (counter) {
        const syncTheme = () => {
            const dark = document.documentElement.classList.contains("dark");
            const mode = dark ? "1" : "0";
            counter.src = counter.src.replace(
                /darkmode=\w+/,
                `darkmode=${mode}`,
            );
        };
        syncTheme();
        new MutationObserver(syncTheme).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }
</script>
