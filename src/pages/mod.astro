---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
---

<BaseLayout title="Moderation - Yuga Sai" showFooterRedirect={false}>
    <div class="max-w-2xl mx-auto px-4">
        <Header />
        <main class="py-8">
            <h1 class="text-2xl sm:text-3xl font-bold mb-4">Moderation</h1>

            <div id="login-screen">
                <form id="mod-login-form" class="max-w-xs">
                    <label for="mod-username" class="block text-sm font-medium mb-1">
                        Username
                    </label>
                    <input
                        type="text"
                        id="mod-username"
                        name="username"
                        autocomplete="username"
                        class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-[#313244] focus:outline-none focus:border-[var(--accent)] mb-3"
                    />
                    <label for="mod-password" class="block text-sm font-medium mb-1">
                        Password
                    </label>
                    <input
                        type="password"
                        id="mod-password"
                        name="password"
                        autocomplete="current-password"
                        class="w-full px-3 py-2 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-[#313244] focus:outline-none focus:border-[var(--accent)] mb-3"
                    />
                    <button
                        type="submit"
                        id="mod-login"
                        class="px-4 py-2 rounded-md bg-[var(--accent)] text-white font-medium hover:opacity-90"
                    >
                        Unlock
                    </button>
                    <p id="login-status" class="mt-3 text-sm"></p>
                </form>
            </div>

            <div id="mod-screen" class="hidden">
                <p id="mod-status" class="text-gray-600 dark:text-gray-400 mb-4"></p>
                <ul id="mod-list" class="space-y-6"></ul>
            </div>
        </main>
    </div>
</BaseLayout>

<script>
    // TODO: replace with your Supabase project URL, anon key, and a mod password
    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
    const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const MOD_PASSWORD = import.meta.env.PUBLIC_MOD_PASSWORD;

    interface GuestbookEntry {
        id: number;
        name: string;
        website: string;
        message: string;
        created_at: string;
        approved: boolean;
        rejected: boolean;
        page: string | null;
    }

    const loginScreen = document.getElementById("login-screen") as HTMLDivElement;
    const modScreen = document.getElementById("mod-screen") as HTMLDivElement;
    const loginForm = document.getElementById("mod-login-form") as HTMLFormElement;
    const passwordInput = document.getElementById(
        "mod-password",
    ) as HTMLInputElement;
    const loginStatus = document.getElementById(
        "login-status",
    ) as HTMLParagraphElement;
    const modStatus = document.getElementById("mod-status") as HTMLParagraphElement;
    const modList = document.getElementById("mod-list") as HTMLUListElement;

    const headers = {
        apikey: SUPABASE_ANON_KEY,
        Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
    };

    const dateFormatter = new Intl.DateTimeFormat("en-us", {
        year: "numeric",
        month: "short",
        day: "numeric",
    });

    function setFavicon(img: HTMLImageElement, website: string) {
        let domain = "";
        try {
            domain = new URL(website).hostname;
        } catch {}
        const sources = [
            `https://icons.duckduckgo.com/ip3/${domain}.ico`,
            `https://www.google.com/s2/favicons?domain=${domain}&sz=64`,
        ];
        const apply = (list: string[]) => {
            if (!list.length) return;
            img.src = list[0];
            img.onerror = () => apply(list.slice(1));
        };
        apply(sources);
    }

    loginForm.addEventListener("submit", (e) => {
        e.preventDefault();
        if (passwordInput.value === MOD_PASSWORD) {
            loginScreen.classList.add("hidden");
            modScreen.classList.remove("hidden");
            passwordInput.value = "";
            loadEntries();
        } else {
            loginStatus.textContent = "Incorrect password.";
        }
    });

    function createRow(entry: GuestbookEntry) {
        const li = document.createElement("li");
        li.className = "py-2";

        const row = document.createElement("div");
        row.className = "flex items-start gap-3";

        const icon = document.createElement("img");
        icon.alt = "";
        icon.loading = "lazy";
        icon.referrerPolicy = "no-referrer";
        icon.className = "w-10 h-10 rounded-lg shrink-0 object-contain";
        setFavicon(icon, entry.website);

        const body = document.createElement("div");
        body.className = "min-w-0 flex-1";

        const header = document.createElement("div");

        const name = document.createElement("a");
        name.href = entry.website;
        name.target = "_blank";
        name.rel = "noopener noreferrer";
        name.textContent = entry.name;
        name.className = "font-semibold text-[var(--accent)] hover:underline";

        const date = document.createElement("span");
        date.className = "text-sm text-gray-500 ml-2";
        date.textContent = dateFormatter.format(new Date(entry.created_at));

        const badge = document.createElement("span");
        const badgeClass = entry.approved
            ? "bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300"
            : entry.rejected
              ? "bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300"
              : "bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300";
        badge.className =
            "ml-2 text-xs font-medium px-2 py-0.5 rounded-full " + badgeClass;
        badge.textContent = entry.approved
            ? "Approved"
            : entry.rejected
              ? "Rejected"
              : "Pending";

        header.append(name, date, badge);

        const message = document.createElement("p");
        message.className = "text-gray-600 dark:text-gray-400 mt-1 break-words";
        message.textContent = entry.message;

        const pageLabel = document.createElement("div");
        pageLabel.className = "mt-1 text-xs text-gray-500";
        if (entry.page) {
            const link = document.createElement("a");
            link.href = `/blog/${encodeURIComponent(entry.page)}`;
            link.textContent = `Blog: ${entry.page}`;
            link.className = "hover:text-[var(--accent)]";
            pageLabel.append(link);
        } else {
            pageLabel.textContent = "Guestbook";
        }

        body.append(header, message, pageLabel);
        row.append(icon, body);
        li.append(row);

        const actions = document.createElement("div");
        actions.className = "mt-3 flex gap-2";

        if (!entry.approved) {
            const approve = document.createElement("button");
            approve.textContent = "Approve";
            approve.dataset.action = "approve";
            approve.dataset.id = String(entry.id);
            approve.className =
                "px-3 py-1.5 rounded-md bg-green-600 text-white text-sm font-medium hover:opacity-90";

            const reject = document.createElement("button");
            reject.textContent = "Reject";
            reject.dataset.action = "reject";
            reject.dataset.id = String(entry.id);
            reject.className =
                "px-3 py-1.5 rounded-md bg-red-600 text-white text-sm font-medium hover:opacity-90";

            actions.append(approve, reject);
        }

        const remove = document.createElement("button");
        remove.textContent = "Delete";
        remove.dataset.action = "delete";
        remove.dataset.id = String(entry.id);
        remove.className =
            "px-3 py-1.5 rounded-md bg-gray-600 text-white text-sm font-medium hover:opacity-90";

        actions.append(remove);
        li.append(actions);

        return li;
    }

    async function loadEntries() {
        try {
            const res = await fetch(
                `${SUPABASE_URL}/rest/v1/guestbook?select=id,name,website,message,created_at,approved,rejected,page&rejected=eq.false&order=created_at.desc`,
                { headers },
            );
            if (!res.ok) throw new Error();
            const entries = (await res.json()) as GuestbookEntry[];
            modStatus.textContent =
                entries.length === 0 ? "No entries yet." : "";
            modList.innerHTML = "";
            entries.forEach((entry) => modList.appendChild(createRow(entry)));
        } catch {
            modStatus.textContent = "Failed to load entries.";
        }
    }

    async function approveEntry(id: number): Promise<Response> {
        return fetch(`${SUPABASE_URL}/rest/v1/guestbook?id=eq.${id}`, {
            method: "PATCH",
            headers: {
                ...headers,
                "Content-Type": "application/json",
                Prefer: "return=minimal",
            },
            body: JSON.stringify({ approved: true, rejected: false }),
        });
    }

    async function rejectEntry(id: number): Promise<Response> {
        return fetch(`${SUPABASE_URL}/rest/v1/guestbook?id=eq.${id}`, {
            method: "PATCH",
            headers: {
                ...headers,
                "Content-Type": "application/json",
                Prefer: "return=minimal",
            },
            body: JSON.stringify({ approved: false, rejected: true }),
        });
    }

    async function deleteEntry(id: number): Promise<Response> {
        return fetch(`${SUPABASE_URL}/rest/v1/guestbook?id=eq.${id}`, {
            method: "DELETE",
            headers,
        });
    }

    modList.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest("[data-action]") as HTMLButtonElement | null;
        if (!button) return;

        const id = Number(button.dataset.id);
        const action = button.dataset.action;
        modStatus.textContent = "Working...";

        let res: Response;
        let status: string;
        try {
            if (action === "approve") {
                res = await approveEntry(id);
                status = "Approved.";
            } else if (action === "reject") {
                res = await rejectEntry(id);
                status = "Rejected.";
            } else {
                res = await deleteEntry(id);
                status = "Deleted.";
            }
        } catch (err) {
            modStatus.textContent = "Error: " + err;
            return;
        }

        modStatus.textContent = res.ok ? status : `Action failed (${res.status}).`;
        loadEntries();
    });
</script>
