---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
    title={`${project.data.title} - Yuga Sai`}
    showFooterRedirect={true}
>
    <div class="max-w-2xl mx-auto px-4">
        <Header />
        <main class="py-8">
            <a
                href={`${import.meta.env.BASE_URL}/projects`}
                class="text-sm text-gray-500 hover:text-blue-500 mb-4 inline-block"
                >← Back to projects</a
            >
            <h1 class="text-4xl font-bold mb-4">{project.data.title}</h1>
            <div class="flex gap-4 mb-8">
                <a
                    href={project.data.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-500 hover:underline">View on GitHub</a
                >
            </div>
            <article class="prose dark:prose-invert max-w-none">
                <Content />
            </article>
        </main>
    </div>
</BaseLayout>
