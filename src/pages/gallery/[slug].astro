---
import { Image, getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import { getAlbums } from "../../lib/gallery";

export async function getStaticPaths() {
    const albums = await getAlbums();
    return albums.map((album) => ({
        params: { slug: album.slug },
        props: { album },
    }));
}

const { album } = Astro.props;

const lightboxImages = await Promise.all(
    album.photos.map(async (photo) => {
        if (photo.src.format === "gif") {
            return { full: photo.src.src, alt: photo.alt };
        }

        const optimized = await getImage({
            src: photo.src,
            width: Math.min(photo.src.width, 1600),
            format: "webp",
            quality: 85,
        });

        return { full: optimized.src, alt: photo.alt };
    }),
);

const photoCount = `${album.photos.length} ${
    album.photos.length === 1 ? "photo" : "photos"
}`;
---

<BaseLayout
    title={`${album.title} - yuga`}
    ogTitle={album.title}
    showFooterRedirect={true}
    description={album.description || `Photos from ${album.title}.`}
    image={album.cover.src.src}
    imageAlt={album.cover.alt}
    type="article"
>
    <Header />
    <div class="max-w-5xl mx-auto px-4">
        <main class="py-8">
            <header class="mb-10">
                <a
                    href="/gallery"
                    class="text-sm text-[var(--accent)] hover:underline"
                >
                    ← back to gallery
                </a>
                <h1 class="text-2xl sm:text-3xl font-bold mt-4">
                    {album.title}
                </h1>
                <div class="flex items-center gap-3 mt-2 text-sm text-gray-500">
                    {
                        album.date && (
                            <time datetime={album.date.toISOString()}>
                                {album.date.toLocaleDateString("en-US", {
                                    month: "long",
                                    year: "numeric",
                                })}
                            </time>
                        )
                    }
                    {album.date && <span>·</span>}
                    <span>{photoCount}</span>
                </div>
                {
                    album.description && (
                        <p class="mt-4 text-gray-600 dark:text-gray-400 max-w-3xl">
                            {album.description}
                        </p>
                    )
                }
            </header>

            <div class="grid grid-cols-2 items-start gap-4 sm:grid-cols-3">
                {
                    album.photos.map((photo, index) => (
                        <button
                            type="button"
                            class="gallery-photo group block w-full overflow-hidden rounded-lg border-0 bg-transparent p-0 cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--accent)]"
                            data-full={lightboxImages[index].full}
                            data-alt={photo.alt}
                            data-caption={photo.caption}
                            aria-label={`Open ${photo.alt}`}
                        >
                            <Image
                                src={photo.src}
                                alt={photo.alt}
                                widths={[400, 800, 1200]}
                                sizes="(min-width: 640px) 33vw, 50vw"
                                loading={index < 3 ? "eager" : "lazy"}
                                class="w-full h-auto transition-transform duration-300 group-hover:scale-[1.02]"
                            />
                        </button>
                    ))
                }
            </div>
        </main>
    </div>

    <dialog
        id="lightbox"
        class="m-auto max-h-none max-w-none border-0 bg-transparent p-0 text-inherit"
    >
        <button
            id="lightbox-close"
            type="button"
            aria-label="Close"
            class="fixed top-4 right-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-xl text-white backdrop-blur transition-colors hover:bg-white/20"
        >
            ✕
        </button>
        <button
            id="lightbox-prev"
            type="button"
            aria-label="Previous photo"
            class="fixed left-4 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-2xl text-white backdrop-blur transition-colors hover:bg-white/20"
        >
            ‹
        </button>
        <div class="flex flex-col items-center">
            <img
                id="lightbox-image"
                alt=""
                class="max-h-[82vh] max-w-[92vw] rounded-lg object-contain shadow-2xl"
            />
            <div
                id="lightbox-caption"
                class="mt-3 max-w-[92vw] text-center text-sm text-white/70"
            >
            </div>
        </div>
        <button
            id="lightbox-next"
            type="button"
            aria-label="Next photo"
            class="fixed right-4 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/10 text-2xl text-white backdrop-blur transition-colors hover:bg-white/20"
        >
            ›
        </button>
    </dialog>
</BaseLayout>

<style is:global>
    #lightbox::backdrop {
        background: rgba(0, 0, 0, 0.85);
        backdrop-filter: blur(4px);
    }

    html:has(#lightbox[open]),
    body:has(#lightbox[open]) {
        overflow: hidden;
    }
</style>

<script>
    const dialog = document.getElementById(
        "lightbox",
    ) as HTMLDialogElement | null;

    if (dialog) {
        const image = document.getElementById(
            "lightbox-image",
        ) as HTMLImageElement;
        const caption = document.getElementById(
            "lightbox-caption",
        ) as HTMLDivElement;
        const closeButton = document.getElementById(
            "lightbox-close",
        ) as HTMLButtonElement;
        const prevButton = document.getElementById(
            "lightbox-prev",
        ) as HTMLButtonElement;
        const nextButton = document.getElementById(
            "lightbox-next",
        ) as HTMLButtonElement;
        const photos = Array.from(
            document.querySelectorAll<HTMLButtonElement>(".gallery-photo"),
        );

        let current = 0;

        const preload = (index: number) => {
            const target = photos[(index + photos.length) % photos.length];
            if (target?.dataset.full) {
                const preloadImage = new window.Image();
                preloadImage.src = target.dataset.full;
            }
        };

        const show = (index: number) => {
            if (photos.length === 0) return;
            current = (index + photos.length) % photos.length;
            const photo = photos[current];
            image.src = photo.dataset.full ?? "";
            image.alt = photo.dataset.alt ?? "";
            caption.textContent = photo.dataset.caption ?? "";
            preload(current - 1);
            preload(current + 1);
        };

        photos.forEach((photo, index) => {
            photo.addEventListener("click", () => {
                show(index);
                dialog.showModal();
            });
        });

        closeButton.addEventListener("click", () => dialog.close());
        prevButton.addEventListener("click", () => show(current - 1));
        nextButton.addEventListener("click", () => show(current + 1));

        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });

        dialog.addEventListener("keydown", (event) => {
            if (event.key === "ArrowLeft") {
                event.preventDefault();
                show(current - 1);
            } else if (event.key === "ArrowRight") {
                event.preventDefault();
                show(current + 1);
            }
        });

        dialog.addEventListener("close", () => {
            image.src = "";
            caption.textContent = "";
            photos[current]?.focus();
        });
    }
</script>
