---
interface Props {
    title: string;
    showFooterRedirect?: boolean;
}

const { title, showFooterRedirect = true } = Astro.props;
const isHome = Astro.url.pathname === "/";
import "../styles/global.css";
import CustomCursor from "../components/CustomCursor.astro";
---

<!doctype html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" href="/images/pfp.jpg" />
        <script is:inline>
            if (localStorage.theme !== "light") {
                document.documentElement.classList.add("dark");
            }
        </script>
        <title>{title}</title>
    </head>
    <body
        class="flex flex-col min-h-full bg-[var(--bg)] text-[var(--text)] transition-colors duration-300"
    >
        <div class="flex-1">
            <slot />
        </div>
        <footer class="max-w-2xl mx-auto px-4 py-8 border-t border-gray-200 dark:border-gray-800 text-center">
            {
                showFooterRedirect && (
                    <a
                        href="/"
                        class="text-sm text-gray-500 hover:text-[var(--accent)]"
                    >
                        ← Back to Home
                    </a>
                )
            }
            {
                isHome && (
                    <div class="mt-6 flex flex-col items-center">
                        <p
                            class="text-[10px] uppercase tracking-widest text-[var(--text-muted)] mb-[5px]"
                        >
                            Visitor count
                        </p>
                        <img
                            id="visitors-counter"
                            src="https://count.getloli.com/@bys-site?name=bys-site&theme=original-new&padding=4&offset=0&align=top&scale=0.5&pixelated=1&darkmode=auto"
                            alt="Visitors counter"
                        />
                    </div>
                )
            }
            <p
                class="mt-4 text-[10px] uppercase tracking-widest text-[var(--text-muted)]"
            >
                Maomao cursors by
                <a
                    href="http://www.rw-designer.com/cursor-set/maomao"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-[var(--accent)]"
                    >PandoraBonf</a
                >
                (CC-BY)
            </p>
        </footer>
        <CustomCursor />
    </body>
</html>

<script>
    const counter = document.getElementById(
        "visitors-counter",
    ) as HTMLImageElement | null;
    if (counter) {
        const syncTheme = () => {
            const dark = document.documentElement.classList.contains("dark");
            const mode = dark ? "1" : "0";
            counter.src = counter.src.replace(
                /darkmode=\w+/,
                `darkmode=${mode}`,
            );
        };
        syncTheme();
        new MutationObserver(syncTheme).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }
</script>
