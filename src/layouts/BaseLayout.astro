---
interface Props {
    title: string;
    showFooterRedirect?: boolean;
    forceLight?: boolean;
    description?: string;
    image?: string;
    imageAlt?: string;
    type?: "website" | "article";
    ogTitle?: string;
}

const {
    title,
    showFooterRedirect = true,
    forceLight = false,
    description = "Welcome to my little corner of the internet! Computer science student and developer.",
    image = "/images/og-card.png",
    imageAlt = "Batchu yuga sai — computer science student and developer",
    type = "website",
    ogTitle = title,
} = Astro.props;
const isHome = Astro.url.pathname === "/";
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
import "../styles/global.css";
import CustomCursor from "../components/CustomCursor.astro";
import ScrollTop from "../components/ScrollTop.astro";
import BadgeRow from "../components/BadgeRow.astro";
---

<!doctype html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical.href} />
        <meta property="og:site_name" content="yuga" />
        <meta property="og:type" content={type} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical.href} />
        <meta property="og:image" content={ogImage.href} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta
            property="og:image:alt"
            content={imageAlt}
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={ogTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage.href} />
        <meta name="theme-color" content="#1e1e2e" />
        <link rel="icon" href="/images/pfp.jpg" />
        {
            !forceLight && (
                <script is:inline>
                    if (localStorage.theme !== "light") {
                        document.documentElement.classList.add("dark");
                    }
                </script>
            )
        }
        <title>{title}</title>
    </head>
    <body
        class="flex flex-col min-h-full bg-[var(--bg)] text-[var(--text)] transition-colors duration-300"
    >
        <div class="flex-1">
            <slot />
        </div>
        {
            (showFooterRedirect || isHome) && (
                <footer class="max-w-2xl mx-auto px-4 py-8 border-t border-gray-200 dark:border-gray-800 text-center">
                    {showFooterRedirect && (
                        <a
                            href="/"
                            class="text-sm text-gray-500 hover:text-[var(--accent)]"
                        >
                            ← Back to Home
                        </a>
                    )}
                    {isHome && <BadgeRow />}
                </footer>
            )
        }
        <CustomCursor />
        <ScrollTop />
    </body>
</html>

<script>
    const counter = document.getElementById(
        "visitors-counter",
    ) as HTMLImageElement | null;
    if (counter) {
        const syncTheme = () => {
            const dark = document.documentElement.classList.contains("dark");
            const mode = dark ? "1" : "0";
            counter.src = counter.src.replace(
                /darkmode=\w+/,
                `darkmode=${mode}`,
            );
        };
        syncTheme();
        new MutationObserver(syncTheme).observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }
</script>
