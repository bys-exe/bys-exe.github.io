---
interface Props {
    title: string;
    showFooterRedirect?: boolean;
}

const { title, showFooterRedirect = true } = Astro.props;
import "../styles/global.css";
---

<!doctype html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" href="/images/pfp.jpg" />
        <script is:inline>
            if (localStorage.theme !== "light") {
                document.documentElement.classList.add("dark");
            }
        </script>
        <title>{title}</title>
    </head>
    <body
        class="h-full bg-[var(--bg)] text-[var(--text)] transition-colors duration-300"
    >
        <slot />
        {
            showFooterRedirect && (
                <footer class="max-w-2xl mx-auto px-4 py-8 border-t border-gray-200 dark:border-gray-800 text-center">
                    <a
                        href="/"
                        class="text-sm text-gray-500 hover:text-blue-500"
                    >
                        ← Back to About
                    </a>
                </footer>
            )
        }
    </body>
</html>
