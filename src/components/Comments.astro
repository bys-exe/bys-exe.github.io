---
interface Props {
    heading?: string;
    reactionsEnabled?: boolean;
    mapping?: string;
    term?: string;
    category?: string;
    categoryId?: string;
}

const {
    heading,
    reactionsEnabled = true,
    mapping = "pathname",
    term = "",
    category = "General",
    categoryId = "DIC_kwDOTJwhRc4DGS2M",
} = Astro.props;
---

<section class="mt-12">
    {heading && <h2 class="text-xl font-semibold mb-4">{heading}</h2>}
    <div
        class="giscus"
        data-reactions-enabled={reactionsEnabled ? "1" : "0"}
        data-mapping={mapping}
        data-term={term}
        data-category={category}
        data-category-id={categoryId}
    >
    </div>
</section>

<script is:inline>
    function getGiscusTheme() {
        return document.documentElement.classList.contains("dark")
            ? "catppuccin_mocha"
            : "catppuccin_latte";
    }

    function loadGiscus() {
        var container = document.querySelector(".giscus");
        if (!container) return;
        var reactionsEnabled =
            container.getAttribute("data-reactions-enabled") || "1";
        var mapping = container.getAttribute("data-mapping") || "pathname";
        var term = container.getAttribute("data-term") || "";
        var category = container.getAttribute("data-category") || "General";
        var categoryId =
            container.getAttribute("data-category-id") ||
            "DIC_kwDOTJwhRc4DGS2M";
        container.innerHTML = "";
        var script = document.createElement("script");
        script.src = "https://giscus.app/client.js";
        script.async = true;
        script.crossOrigin = "anonymous";
        script.setAttribute("data-repo", "bys-exe/bys-exe.github.io");
        script.setAttribute("data-repo-id", "R_kgDOTJwhRQ");
        script.setAttribute("data-category", category);
        script.setAttribute("data-category-id", categoryId);
        script.setAttribute("data-mapping", mapping);
        script.setAttribute("data-strict", "0");
        if (mapping === "specific" && term) {
            script.setAttribute("data-term", term);
        }
        script.setAttribute("data-reactions-enabled", reactionsEnabled);
        // carry category for debugging
        container.setAttribute("data-category", category);
        script.setAttribute("data-emit-metadata", "0");
        script.setAttribute("data-input-position", "top");
        script.setAttribute("data-theme", getGiscusTheme());
        script.setAttribute("data-lang", "en");
        script.setAttribute("data-loading", "lazy");
        container.appendChild(script);
    }

    function syncGiscusTheme() {
        var iframe = document.querySelector("iframe.giscus-frame");
        if (!iframe || !iframe.contentWindow) return;
        iframe.contentWindow.postMessage(
            { giscus: { setConfig: { theme: getGiscusTheme() } } },
            "https://giscus.app",
        );
    }

    loadGiscus();
    new MutationObserver(syncGiscusTheme).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
    });
</script>
