---
interface Props {
    persistTheme?: boolean;
}

const { persistTheme = true } = Astro.props;
import ThemeSwitcher from "./ThemeSwitcher.astro";
---

<header class="relative flex flex-col sm:flex-row sm:justify-center items-center gap-3 sm:gap-4 px-4 py-6">
    <nav class="flex flex-wrap justify-center gap-x-3 gap-y-2 text-sm sm:text-base md:gap-x-5">
        <a href="/" class="hover:text-[var(--accent)]">Home</a>
        <a href="/about" class="hover:text-[var(--accent)]">About</a>
        <a href="/projects" class="hover:text-[var(--accent)]">Projects</a>
        <a href="/blog" class="hover:text-[var(--accent)]">Blog</a>
        <a href="/gallery" class="hover:text-[var(--accent)]">Gallery</a>
        <a href="/guestbook" class="hover:text-[var(--accent)]">Guestbook</a>
        <a href="/contact" class="hover:text-[var(--accent)]">Contact</a>
    </nav>
    <div class="flex items-center gap-2 sm:static md:absolute md:right-4 md:top-1/2 md:-translate-y-1/2">
        <ThemeSwitcher persistTheme={persistTheme} />
    </div>
</header>
