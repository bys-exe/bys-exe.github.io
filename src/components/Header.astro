---
import ThemeSwitcher from "./ThemeSwitcher.astro";
---

<header class="flex justify-center items-center py-6">
    <div class="flex items-center gap-6">
        <nav class="flex gap-4">
            <a href={import.meta.env.BASE_URL} class="hover:text-blue-500">About</a>
            <a href={`${import.meta.env.BASE_URL}/projects`} class="hover:text-blue-500">Projects</a>
            <a href={`${import.meta.env.BASE_URL}/blog`} class="hover:text-blue-500">Blog</a>
            <a href={`${import.meta.env.BASE_URL}/achievements`} class="hover:text-blue-500">Achievements</a>
            <a href={`${import.meta.env.BASE_URL}/contact`} class="hover:text-blue-500">Contact</a>
        </nav>
        <div class="ml-4">
            <ThemeSwitcher />
        </div>
    </div>
</header>
